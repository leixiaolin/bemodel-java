# =============================================================
# 临床 SHACL Shapes —— 与 docs/ontology-top-template-owl-shacl.md §3 一一对应
# 数据侧（ABox）由 RdfService.exportPatient 生成，谓词命名与本文档严格对齐。
# 六Shape：1 过敏禁忌 / 2 剂量上限 / 3 儿童禁用 / 4 性别互斥诊断 / 5 相互作用 / 6 处方审核闭环
# =============================================================
@prefix med:  <http://bemodel.com/ontology/med#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Shape 1：过敏禁忌（患者对某过敏原过敏 ⇒ 处方药品不得含该过敏原）
med:AllergyConstraint a sh:NodeShape ;
    sh:targetClass med:DrugOrder ;
    sh:message "处方违反过敏禁忌：患者对药品成分过敏" ;
    sh:sparql [ sh:select """
        PREFIX med: <http://bemodel.com/ontology/med#>
        SELECT $this WHERE {
            $this a med:DrugOrder ; med:prescribesDrug ?drug .
            $this ^med:hasOrder ?enc . ?enc ^med:hasEncounter ?patient .
            ?patient med:hasAllergyTo ?allergen .
            ?drug med:containsAllergen ?allergen .
        }""" ] .

# Shape 2：剂量上限（单日剂量 = 单次剂量 × 频次 > 日最大剂量）
med:DoseLimitShape a sh:NodeShape ;
    sh:targetClass med:DrugOrder ;
    sh:message "单日剂量超过药品日最大剂量" ;
    sh:sparql [ sh:select """
        PREFIX med: <http://bemodel.com/ontology/med#>
        SELECT $this WHERE {
            $this med:prescribesDrug ?drug ;
                  med:singleDose ?dose ;
                  med:frequency ?freq .
            ?drug med:maxDailyDose ?max .
            BIND( ?dose * IF(?freq IN ("bid"), 2, IF(?freq IN ("tid"), 3, IF(?freq = "q8h", 3, 1))) AS ?daily )
            FILTER( ?daily > ?max )
        }""" ] .

# Shape 3：儿童禁用（年龄互斥）
med:ChildForbiddenShape a sh:NodeShape ;
    sh:targetClass med:DrugOrder ;
    sh:message "儿童禁用药品用于儿童患者" ;
    sh:sparql [ sh:select """
        PREFIX med: <http://bemodel.com/ontology/med#>
        SELECT $this WHERE {
            $this med:prescribesDrug ?drug .
            ?drug med:childForbidden true .
            $this ^med:hasOrder ?enc . ?enc ^med:hasEncounter ?patient .
            ?patient med:age ?age . FILTER( ?age < 14 )
        }""" ] .

# Shape 4：性别互斥诊断（公理 AX-003 的 SHACL 形态：男 × 妊娠/妇科 ICD 章）
med:SexDisjointDiagShape a sh:NodeShape ;
    sh:targetClass med:Patient ;
    sh:message "男性患者不允许出现妊娠/妇科类诊断" ;
    sh:sparql [ sh:select """
        PREFIX med: <http://bemodel.com/ontology/med#>
        SELECT $this WHERE {
            $this med:sex "男" ; med:hasEncounter ?enc .
            ?enc med:hasDiagnosis ?diag .
            ?diag med:icd10Code ?icd .
            FILTER( STRSTARTS(?icd, "O") || STRSTARTS(?icd, "N83") )
        }""" ] .

# Shape 5：药物相互作用（同方共存检测）
med:InteractionShape a sh:NodeShape ;
    sh:targetClass med:Encounter ;
    sh:message "同一就诊存在相互作用药品联用" ;
    sh:sparql [ sh:select """
        PREFIX med: <http://bemodel.com/ontology/med#>
        SELECT $this WHERE {
            ?o1 ^med:hasOrder $this ; med:prescribesDrug ?d1 .
            ?o2 ^med:hasOrder $this ; med:prescribesDrug ?d2 .
            ?d1 med:interactsWith ?d2 .
            FILTER( STR(?d1) < STR(?d2) )
        }""" ] .

# Shape 6：处方完整性（必填字段 + 审核闭环）
med:PrescriptionShape a sh:NodeShape ;
    sh:targetClass med:Prescription ;
    sh:property [ sh:path med:reviewedBy ; sh:minCount 1 ; sh:message "处方未经药师审核不得发药" ] ;
    sh:property [ sh:path med:prescribedBy ; sh:minCount 1 ; sh:message "处方必须有开立医生" ] .
